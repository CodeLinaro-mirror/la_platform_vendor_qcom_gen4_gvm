import /vendor/etc/init/hw/init.qti.kernel.rc

on early-init
    write /sys/block/dm-6/queue/read_ahead_kb 4096
    write /sys/block/dm-7/queue/read_ahead_kb 4096
    write /sys/block/dm-8/queue/read_ahead_kb 4096
    write /sys/block/dm-9/queue/read_ahead_kb 4096
    write /sys/block/dm-10/queue/read_ahead_kb 4096
    write /sys/block/dm-11/queue/read_ahead_kb 4096
    write /sys/block/vda/queue/read_ahead_kb 4096
    write /sys/block/vdb/queue/read_ahead_kb 4096
    write /sys/block/vdc/queue/read_ahead_kb 4096
    write /sys/block/vdd/queue/read_ahead_kb 4096
    write /sys/block/vde/queue/read_ahead_kb 4096
    write /sys/block/vdf/queue/read_ahead_kb 4096
    write /sys/block/vdg/queue/read_ahead_kb 4096
    write /sys/block/vdl/queue/read_ahead_kb 4096
    chown system system /sys/kernel/boot_kpi/kpi_values
    #write /proc/sys/kernel/sched_boost 1
    symlink /data/tombstones /tombstones
    write /dev/console "boot_kpi: M - INITRC Userspace Start"

# Updating the symlinks for the new CDC-partitions
on early-init && property:ro.product.name=gen4_gvm_cdccomm
    symlink /dev/block/vvmtruststore        /dev/block/by-name/vvmtruststore
    symlink /dev/block/update               /dev/block/by-name/update
    symlink /dev/block/ehorizon             /dev/block/by-name/ehorizon
    symlink /dev/block/factory              /dev/block/by-name/factory
    symlink /dev/block/persistent-logging   /dev/block/by-name/persistent-logging
    symlink /dev/block/oem_map              /dev/block/by-name/oem_map
    symlink /dev/block/oem0                 /dev/block/by-name/oem0
    symlink /dev/block/oem1                 /dev/block/by-name/oem1
    symlink /dev/block/diagnostic           /dev/block/by-name/diagnostic
    symlink /dev/block/confcal_1            /dev/block/by-name/confcal_1
    symlink /dev/block/confptstatic         /dev/block/by-name/confptstatic
    symlink /dev/block/persist-alliance     /dev/block/by-name/persist-alliance
    symlink /dev/block/earlydata            /dev/block/by-name/earlydata
    symlink /dev/block/oem_a                /dev/block/by-name/oem_a
    symlink /dev/block/oem_b                /dev/block/by-name/oem_b
    symlink /dev/block/oemfactorystate      /dev/block/by-name/oemfactorystate
    symlink /dev/block/confptid             /dev/block/by-name/confptid
    symlink /dev/block/confraw              /dev/block/by-name/confraw
    symlink /dev/block/tier1_diagnostic     /dev/block/by-name/tier1_diagnostic
    symlink /dev/block/confcal_0            /dev/block/by-name/confcal_0
    symlink /dev/block/oem_ext_a            /dev/block/by-name/oem_ext_a
    symlink /dev/block/oem_ext_b            /dev/block/by-name/oem_ext_b
    symlink /dev/block/rbvm_oem0            /dev/block/by-name/rbvm_oem0
    symlink /dev/block/rbvm_oem1            /dev/block/by-name/rbvm_oem1
    symlink /dev/block/fvm_confraw          /dev/block/by-name/fvm_confraw

# Elite
on early-init && property:ro.boot.audio=""
     setprop vendor.audio.card.def "/vendor/etc/card-defs-dummy.xml"

# AudioReach
on early-init && property:ro.boot.audio=audioreach
     setprop ro.hardware.audio.primary "gen4.ar"
     setprop ro.hardware.sound_trigger.primary "gen4.ar"

# AudioReach GEN3
on early-init && property:ro.boot.audio=audioreach_gen3
     setprop ro.hardware.audio.primary "msmnile.ar"
     setprop ro.hardware.sound_trigger.primary "msmnile.ar"

# AudioReach VIO
on early-init && property:ro.boot.audio=ar
     exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -b -s -d /vendor/lib/modules msm_virtio_snd audio_variant="audioreach_vio"
     setprop ro.hardware.audio.primary "gen4.ar"
     setprop ro.hardware.sound_trigger.primary "gen4.ar"
# Audiolite
on early-init && property:ro.boot.audio=audiolite
     setprop ro.hardware.audio.primary "default"
     setprop ro.hardware.sound_trigger.primary "default"
     setprop vendor.audio.hal.stubmode 1

on early-init && property:ro.boot.audio=awe
     exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -b -s -d /vendor/lib/modules msm_virtio_snd audio_variant="awe"
     setprop ro.hardware.audio.primary "gen4.awe"
     setprop ro.hardware.sound_trigger.primary "gen4.awe"

on init
    write /dev/stune/foreground/schedtune.sched_boost_no_override 1
    write /dev/stune/top-app/schedtune.sched_boost_no_override 1
    write /dev/stune/schedtune.colocate 0
    write /dev/stune/background/schedtune.colocate 0
    write /dev/stune/system-background/schedtune.colocate 0
    write /dev/stune/foreground/schedtune.colocate 0
    write /dev/stune/top-app/schedtune.colocate 1
    write /sys/module/qpnp_rtc/parameters/poweron_alarm 1

on init && property:vendor.dlog_service.enabled=0
    trigger dlog_init

on init && property:vendor.dlog_service.enabled=1
    trigger dlog_init

on dlog_init
    mkdir /dev/qdss 0755 system system
    restorecon /dev/qdss
    write /dev/qdss/enable_dlog ${vendor.dlog_service.enabled}
    chown system system /dev/qdss/enable_dlog
    chmod 0644 /dev/qdss/enable_dlog
    restorecon /dev/qdss/enable_dlog
    write /dev/qdss/elf_offsets ""
    chown system system /dev/qdss/elf_offsets
    chmod 0644 /dev/qdss/elf_offsets
    restorecon /dev/qdss/elf_offsets
    start dlog_service

on property:vendor.dlog_service.enabled=1
    write /dev/qdss/enable_dlog "1"

on property:vendor.dlog_service.enabled=0
    write /dev/qdss/enable_dlog "0"

on init && property:vendor.gdb.dump=true
    setrlimit 4 -1 -1

on property:vendor.gdb.dump=true
    mkdir data/core
    chmod 0777 data/core
    write /proc/sys/kernel/core_pattern "/data/core/core.%e.%p.%h.%t"

on fs
    mount_all --early
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0700 system system

on late-fs
    mount_all --late
    write /sys/block/dm-46/queue/read_ahead_kb 4096

on post-fs
    start vendor.sec_nvm
    write /dev/cpuctl/foreground/cpu.uclamp.min 50

on post-fs-data
    mkdir /vendor/data/tombstones 0771 system system
    mkdir /tombstones/modem 0771 system system
    mkdir /tombstones/lpass 0771 system system
    mkdir /tombstones/wcnss 0771 system system
    mkdir /tombstones/dsps 0771 system system
    mkdir /data/vendor/hbtp 0750 system system
    mkdir /data/vendor/tloc 0700 system drmrpc
    mkdir /data/vendor/nnhal 0700 system system

    #Create folder for ais_server
    mkdir /dev/socket/camera 0770 system camera

# For cpusets initialize for Silver Only first and then Silver + Gold
# Silver Only configuration cannot work with 0-7
on boot
    chown system system /sys/kernel/hbtp/display_pwr
    start rmt_storage
    start rfs_access
    start wlan_multiko

    # Create netmgr recovery folder
    mkdir /data/vendor/netmgr/recovery 0700 radio radio
    chmod 0770 /data/vendor/netmgr/recovery
    write /data/vendor/netmgr/recovery/recovery_info ""
    chown radio radio /data/vendor/netmgr/recovery/recovery_info

    #update cpusets for background tasks on gvm
    write /dev/cpuset/background/cpus 4-7
    write /dev/cpuset/system-background/cpus 4-7

# Add a cpuset for the camera daemon
# We want all cores for camera
    mkdir /dev/cpuset/camera-daemon
    # write /dev/cpuset/camera-daemon/cpus 0-3
    write /dev/cpuset/camera-daemon/mems 0
    chown cameraserver cameraserver /dev/cpuset/camera-daemon
    chown cameraserver cameraserver /dev/cpuset/camera-daemon/tasks
    chmod 0660 /dev/cpuset/camera-daemon/tasks

# vnw
    write /dev/ptpshm 0
    write /dev/sctptpshm 0
    chmod 0660 /dev/ptpshm
    chmod 0660 /dev/sctptpshm

#USB controller configuration
    setprop vendor.usb.rndis.func.name "gsi"
    setprop vendor.usb.rmnet.func.name "gsi"
    setprop vendor.usb.rmnet.inst.name "rmnet"
    setprop vendor.usb.dpl.inst.name "dpl"
    setprop vendor.usb.qdss.inst.name "qdss_sw"
    setprop sys.usb.configfs 1

on property:ro.soc.model="SA7255P"
    write /dev/cpuset/top-app/cpus 0-3

on property:ro.boot.usbcontroller=*
    setprop vendor.usb.controller ${ro.boot.usbcontroller}

on boot && property:persist.vendor.usb.controller.default=*
    setprop vendor.usb.controller ${persist.vendor.usb.controller.default}

on property:vendor.usb.controller=* && property:ro.boot.hwversion=1
    setprop sys.usb.controller ${vendor.usb.controller}

#hwversion property is applicable to CDC
on property:vendor.usb.controller=* && property:ro.boot.hwversion=2
    write /sys/devices/platform/soc/a600000.hsusb/mode peripheral
    write /sys/devices/platform/soc/a400000.hsusb/mode host
    setprop vendor.usb.rncdc.bsample.controller ${vendor.usb.controller}
    setprop sys.usb.controller ${vendor.usb.rncdc.bsample.controller}

on property:vendor.usb.controller=* && property:ro.boot.hwversion=3
    write /sys/devices/platform/soc/a600000.hsusb/mode host
    write /sys/devices/platform/soc/a400000.hsusb/mode peripheral
    setprop vendor.usb.rncdc.dvsample.controller ${vendor.usb.controller}
    setprop sys.usb.controller ${vendor.usb.rncdc.dvsample.controller}

on property:init.svc.zygote=running
    write /dev/console "boot_kpi:M - USER Zygote Start"
    write /sys/kernel/boot_kpi/kpi_values "M - USER Zygote Start"

on property:service.bootanim.exit=0
    write /dev/console "boot_kpi: K - USER Boot Animation Start"
    write /sys/kernel/boot_kpi/kpi_values "K - USER Boot Animation Start"

on property:sys.boot_completed=1
    write /dev/console "boot_kpi: K - USER Android Boot Complete"
    write /sys/kernel/boot_kpi/kpi_values "K - USER Android Boot Complete"

on property:init.svc.surfaceflinger=running
    write /dev/console "boot_kpi: M - USER SurfaceFlinger Start"
    write /sys/kernel/boot_kpi/kpi_values "M - USER SurfaceFlinger Start"

on property:vendor.all.modules.ready=1
    write /dev/console "boot_kpi: M - Vendor Modprobe completed"


#pd-mapper
service vendor.pd_mapper /vendor/bin/pd-mapper
    class core
    user system
    group system

service wlan_multiko /vendor/bin/init.qcom.wlan.sh
    user root
    group root
    disabled
    oneshot

service vendor.sec_nvm /vendor/bin/sec_nvm
    class core
    user system
    group system

service vendor.thermal-engine /vendor/bin/thermal-engine
   class main
   user root
   socket thermal-send-client stream 0666 system system
   socket thermal-recv-client stream 0660 system system
   socket thermal-recv-passive-client stream 0666 system system
   socket thermal-send-rule stream 0660 system system
   group root

service amfsservice /vendor/bin/amfsservice
    class main
    user system
    group system

service audiod /vendor/bin/audiod
    class main
    user system
    group system wakelock
    capabilities BLOCK_SUSPEND

service dlog_service /vendor/bin/dlog_service
    class main
    user system
    group system
    disabled

service vendor.mdm_helper /vendor/bin/mdm_helper
    user system
    class core
    group system wakelock
    disabled

service vendor.mdm_launcher /vendor/bin/sh /vendor/bin/init.mdm.sh
    user system
    group system
    class main
    oneshot
    disabled

on property:vold.decrypt=trigger_restart_framework
    start cnss_diag

service cnss_diag /system/vendor/bin/cnss_diag -q -f -t HELIUM
    class main
    user system
    group system wifi inet sdcard_rw media_rw diag
    oneshot

service vendor.energy-awareness /vendor/bin/energy-awareness
    class main
    user system
    group system
    oneshot

service vendor.tlocd /vendor/bin/tloc_daemon
    class late_start
    user system
    group drmrpc gps net_raw

#Start EMAC ethernet driver
on boot
    insmod /vendor/lib/modules/emac_dwc_eqos.ko

on property:sys.boot_completed=1
    mkdir /data/vendor/fastcv 0700 media media
    start fastcv
    start drm_smmu

service drm_smmu /vendor/bin/init.drm.smmu.sh
    user media
    group media
    disabled
    oneshot

service fastcv /vendor/bin/fastcv.sh
    user media
    group media
    disabled
    oneshot

